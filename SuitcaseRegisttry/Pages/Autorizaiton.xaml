<Page x:Class="SuitcaseRegisttry.Pages.Autorizaiton"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SuitcaseRegisttry.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White"/>
                <GradientStop Color="#FF8030E6" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
            <TextBlock Text="Реестр чемоданов" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Franklin Gothic Heavy"/>
            <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Franklin Gothic Heavy"/>

            <TextBlock Text="ФИО:" FontSize="14" Margin="5,0,5,5" FontFamily="Franklin Gothic Heavy"/>
            <TextBox x:Name="txtFIO" Margin="0,0,0,8"/>

            <TextBlock Text="Роль:" FontSize="14" Margin="5,0,5,5" FontFamily="Franklin Gothic Heavy"/>
            <TextBox x:Name="txtRoles" Margin="0,0,0,8"/>

            <TextBlock Text="Email:" FontSize="14" Margin="5,0,5,5" FontFamily="Franklin Gothic Heavy"/>
            <TextBox x:Name="txtEmail" Margin="0,0,0,8"/>

            <TextBlock Text="Номер рейса:" FontSize="14" Margin="5,0,5,5" FontFamily="Franklin Gothic Heavy"/>
            <TextBox x:Name="txtFlight" Margin="0,0,0,8"/>

            <CheckBox x:Name="cbDangerous" Content="Есть опасные признаки" Margin="0,0,0,12" FontWeight="Bold"/>

            <Button Content="Проверить чемодан" Height="32" Click="BtnCheckSuitcase_Click"/>
            <TextBlock x:Name="txtStatus" Margin="0,12,0,0" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
