<Window x:Class="SuitcaseRegisttry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuitcaseRegisttry"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Реестр чемоданов: таможня магического транспорта" Height="450" Width="800" >
    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF17294C"/>
                <GradientStop Color="#FF49316D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Frame x:Name="FrmMain" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
